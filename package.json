    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "~8.65.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@^2": "^2.0.8",
      "multer@^2": "^2.5.0",
      "body-parser@^1": "^1.20.9",
      "sharp@^0.34": "^0.35.5",
      "postcss@^8": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "source-map-js@^1": "^1.2.2",
      "js-yaml@^4": "^4.3.2",
      "brace-expansion@^1": "^1.1.20",
