# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
# ADR-0038 : `/build` est aussi une ROUTE web (bureau du module BUILD), pas un
# dossier de sortie : elle doit être versionnée.
!apps/web/src/app/(app)/build/
.next/
.turbo/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# Test coverage
coverage/

# Rapport JSON de vitest (produit uniquement en CI — voir scripts/verify-e2e-executed.mjs)
.vitest/
.nyc_output/

# Docker volumes
.docker-data/

# Golden files temporary outputs
packages/engine/__golden__/**/actual.*.json
packages/engine/__golden__/**/actual.*.xlsx
packages/engine/__golden__/**/actual.*.csv

# Smoke test artifacts (S8-lite PDF)
apps/api/scripts/smoke-*.pdf
apps/api/scripts/smoke-*.html

# Env de production (VPS uniquement, jamais commité)
.env.production

# Documentation DGI remise au compte développeur (formulaires, protocoles, cas de test).
# Le dépôt est PUBLIC : ces pièces restent locales. Seules les sources publiques
# vont dans docs/sources/dgi-rdc/.
/dgi/

# Copies de travail des agents (git worktrees créés dans le dépôt).
/.claude/worktrees/
