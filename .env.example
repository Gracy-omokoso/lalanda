# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
# Toutes les variables sont validées par Zod au démarrage.
# Voir packages/shared/src/env.

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── API ────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# ─── Web ────────────────────────────────────────────────────
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── MongoDB (replica set — ADR-0004) ───────────────────────
MONGODB_URI=mongodb://localhost:27017/lalanda?replicaSet=rs0&directConnection=true
MONGODB_DB=lalanda

# ─── Redis (BullMQ) — OPTIONNEL, requis à partir des exports asynchrones ──
# REDIS_URL=redis://localhost:6379

# ─── Stockage objet (MinIO local, Spaces en prod) ───────────
# OPTIONNEL — requis à partir des exports asynchrones (S16a).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=lalanda
# S3_SECRET_KEY=lalanda-dev-secret
# S3_BUCKET_EXPORTS=lalanda-exports
# S3_BUCKET_SNAPSHOTS=lalanda-snapshots
# S3_BUCKET_UPLOADS=lalanda-uploads
# S3_FORCE_PATH_STYLE=true

# ─── Auth (better-auth — ADR-0006) ──────────────────────────
AUTH_SECRET=change-me-generate-a-32-byte-secret
AUTH_URL=http://localhost:3000
# Vérification d'email bloquante (S16a). false en dev (pas de SMTP) ;
# passer à true en production dès qu'un fournisseur d'envoi est branché.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Connexion Google (ADR-0006 / ADR-0014) — OPTIONNEL ─────
# Les DEUX ou AUCUNE. Sans elles : l'API démarre, le bouton
# « Continuer avec Google » ne s'affiche pas.
# Procédure d'obtention détaillée : docs/adr/ADR-0014.
# URI de redirection à déclarer en dev : http://localhost:3001/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Envoi d'emails (SMTP — ADR-0014) — OPTIONNEL ───────────
# Sans SMTP_HOST : aucun envoi, repli sur log serveur, l'API démarre normalement.
# En local, MailHog : SMTP_HOST=localhost / SMTP_PORT=1025 (ni user ni mot de passe).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Lalanda <no-reply@exemple.com>

# ─── IA (OpenAI — ADR-0008) ─────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_LITE=gpt-4o-mini

# ─── Paiements (S12, non requis en S0) ──────────────────────
# PAWAPAY_API_KEY=
# STRIPE_SECRET_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
