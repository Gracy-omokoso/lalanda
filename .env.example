# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
# Toutes les variables sont validées par Zod au démarrage.
# Voir packages/shared/src/env.

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── API ────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# ─── Web ────────────────────────────────────────────────────
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── MongoDB (replica set — ADR-0004) ───────────────────────
MONGODB_URI=mongodb://localhost:27017/lalanda?replicaSet=rs0&directConnection=true
MONGODB_DB=lalanda

# ─── Redis (BullMQ) — OPTIONNEL, requis à partir des exports asynchrones ──
# REDIS_URL=redis://localhost:6379

# ─── Stockage objet (MinIO local, Spaces en prod) ───────────
# OPTIONNEL — requis à partir des exports asynchrones (S16a).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=lalanda
# S3_SECRET_KEY=lalanda-dev-secret
# S3_BUCKET_EXPORTS=lalanda-exports
# S3_BUCKET_SNAPSHOTS=lalanda-snapshots
# S3_BUCKET_UPLOADS=lalanda-uploads
# S3_FORCE_PATH_STYLE=true

# ─── Auth (better-auth — ADR-0006) ──────────────────────────
AUTH_SECRET=change-me-generate-a-32-byte-secret
AUTH_URL=http://localhost:3000
# Vérification d'email bloquante (S16a). false en dev (pas de SMTP) ;
# passer à true en production dès qu'un fournisseur d'envoi est branché.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Coffre des secrets d'intégration (S21b — ADR-0013) ─────
# REQUIS. L'API refuse de démarrer sans cette variable, ou si elle ne décode
# pas vers exactement 32 octets.
#
#   openssl rand -base64 32
#
# C'est la clé qui protège TOUS les secrets d'intégration stockés en base
# (OpenAI, Stripe, PayPal, SMTP, S3). Deux conséquences à connaître AVANT de
# la générer :
#
#   - la PERDRE rend les secrets définitivement irrécupérables. Ce n'est pas
#     une perte de données : la copie faisant autorité de chaque clé vit chez
#     le fournisseur, et la reprise consiste à les re-saisir dans /admin ;
#   - la SAUVEGARDER AU MÊME ENDROIT que les sauvegardes de base annule tout
#     l'intérêt du dispositif (ADR-0013 §10). Coffre et clé se rangent
#     séparément, sinon une seule fuite suffit.
SECRETS_MASTER_KEY=change-me-openssl-rand-base64-32
SECRETS_MASTER_KEY_ID=k1
# Uniquement PENDANT une rotation (ADR-0013 §3) : déployer avec l'ancienne clé
# ici, exécuter `secrets:rewrap`, vérifier qu'aucun document ne porte l'ancien
# keyId, puis retirer ces deux lignes et redéployer.
# SECRETS_MASTER_KEY_PREVIOUS=
# SECRETS_MASTER_KEY_PREVIOUS_ID=k0

# ─── IA (OpenAI — ADR-0008, ADR-0013) ───────────────────────
# OPTIONNELLE depuis S21b : la clé se saisit dans /admin → Intégrations, et y
# est chiffrée. Cette variable reste un SECOURS pendant la migration — la
# résolution est « base d'abord, environnement ensuite », et /admin affiche la
# source effective. À retirer au sprint de sortie de la migration.
# OPENAI_API_KEY=sk-...

# ─── Connexion Google (ADR-0006 / ADR-0014) — OPTIONNEL ─────
# Les DEUX ou AUCUNE. Sans elles : l'API démarre, le bouton
# « Continuer avec Google » ne s'affiche pas.
# Procédure d'obtention détaillée : docs/adr/ADR-0014.
# URI de redirection à déclarer en dev : http://localhost:3001/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Envoi d'emails (SMTP — ADR-0014) — OPTIONNEL ───────────
# Sans SMTP_HOST : aucun envoi, repli sur log serveur, l'API démarre normalement.
# En local, MailHog : SMTP_HOST=localhost / SMTP_PORT=1025 (ni user ni mot de passe).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Lalanda <no-reply@exemple.com>

# ─── IA (OpenAI — ADR-0008) ─────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_LITE=gpt-4o-mini

# Bornes techniques des appels OpenAI (S22h) — TOUTES OPTIONNELLES.
# Sans elles, les défauts sûrs de apps/api/src/ai/ai-limits.ts s'appliquent :
# un déploiement non configuré est borné, jamais illimité.
# Une valeur invalide ou hors bornes est ignorée au profit du défaut, avec un
# avertissement au démarrage.
#   OPENAI_MAX_OUTPUT_TOKENS : plafond de jetons EN SORTIE. Défaut 1024,
#     accepté entre 256 et 4096. La réponse légitime la plus longue de
#     /ai/corrective-actions (4 actions) pèse ~470 jetons.
#   OPENAI_TIMEOUT_MS : délai maximal d'un appel. Défaut 15000, accepté entre
#     1000 et 60000. Au-delà, le repli déterministe prend la main.
# OPENAI_MAX_OUTPUT_TOKENS=1024
# OPENAI_TIMEOUT_MS=15000

# ─── Paiements (S12) ────────────────────────────────────────
# Stripe et PayPal ne passent PAS par l'environnement : leurs identifiants se
# saisissent dans /admin → Intégrations (ADR-0013 §8, « si le processus en a
# besoin avant d'avoir lu la base, il va dans l'environnement ; sinon il va
# dans `integrations` »).
