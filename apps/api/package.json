{
  "name": "@lalanda/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo",
    "edef:calibrate": "tsx src/edef/calibration/calibrate.ts",
    "edef:homologation": "tsx src/edef/homologation/homologation.ts",
    "modele:valider": "tsx src/sales/documents/templates/custom/cli.ts",
    "edef:homologation:dist": "node --enable-source-maps dist/edef/homologation/homologation.js"
  },
  "dependencies": {
    "@lalanda/engine": "workspace:*",
    "@lalanda/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "better-auth": "^1.1.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "mongodb": "^6.11.0",
    "mongoose": "^8.9.5",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^10.1.7",
    "openai": "^4.104.0",
    "pino-http": "^10.3.0",
    "puppeteer": "^25.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^6.0.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
