{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.local"],
  // Turborepo 2 tourne en `envMode: "strict"` par défaut : une tâche ne reçoit QUE
  // les variables listées ici (+ les variables système). Sans cette liste, un
  // `MONGODB_URI` exporté par la CI n'atteint jamais le process vitest et toutes
  // les suites e2e se mettent silencieusement en `describe.skip` — job vert, zéro
  // couverture (S19a). La liste reflète le schéma `packages/shared/src/env`.
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "API_PORT",
    "API_URL",
    "WEB_PORT",
    "WEB_URL",
    "NEXT_PUBLIC_API_URL",
    "MONGODB_URI",
    "MONGODB_DB",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET_EXPORTS",
    "S3_BUCKET_SNAPSHOTS",
    "S3_BUCKET_UPLOADS",
    "S3_FORCE_PATH_STYLE",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_REQUIRE_EMAIL_VERIFICATION",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "OPENAI_API_KEY",
    "OPENAI_MODEL_REASONING",
    "OPENAI_MODEL_LITE",
    "LALANDA_REQUIRE_E2E"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Rapport JSON de vitest, produit uniquement en CI (LALANDA_REQUIRE_E2E=1)
      // et consommé par scripts/verify-e2e-executed.mjs. Déclaré en `outputs`
      // pour être restauré aussi sur un cache hit — sinon la vérification
      // anti-skip échouerait faute de rapport.
      "outputs": [".vitest/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
