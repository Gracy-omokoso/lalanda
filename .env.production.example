# Environnement de PRODUCTION — copie en `.env.production` sur le VPS et remplis
# les secrets. `.env.production` est gitignoré : AUCUN secret réel dans ce fichier
# d'exemple (ADR-0009 : les secrets vivent dans GitHub Secrets / sur le Droplet).
#
# Consommé par docker-compose.prod.yml :
#   - services api/web via `env_file` ;
#   - caddy/minio via interpolation ${...}.

# ─── Domaines & TLS (Caddy) ─────────────────────────────────
APP_DOMAIN=app.lalanda.example
API_DOMAIN=api.lalanda.example
ACME_EMAIL=ops@lalanda.example

# ─── Version des images (GHCR) ──────────────────────────────
# Tag poussé par .github/workflows/deploy.yml (ex: v0.2.0). Défaut: latest.
LALANDA_TAG=latest

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── API ────────────────────────────────────────────────────
API_PORT=3001
API_URL=https://api.lalanda.example
WEB_URL=https://app.lalanda.example

# ─── Web ────────────────────────────────────────────────────
# Rappel : NEXT_PUBLIC_API_URL est aussi inlinée AU BUILD de l'image web
# (build-arg dans .github/workflows/deploy.yml). Garder les deux alignées.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.lalanda.example

# ─── MongoDB (replica set rs0 — ADR-0004) ───────────────────
MONGODB_URI=mongodb://mongo:27017/lalanda?replicaSet=rs0&directConnection=true
MONGODB_DB=lalanda

# ─── Redis (BullMQ) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Stockage objet ─────────────────────────────────────────
# MinIO sur le Droplet par défaut. Le service parle indifféremment MinIO, DO
# Spaces ou Cloudflare R2 : c'est le MÊME protocole (SigV4, service `s3`), et le
# choix se fait par la seule valeur S3_ENDPOINT.
#
#   - DO Spaces : S3_ENDPOINT=https://ams3.digitaloceanspaces.com,
#     S3_REGION=ams3, S3_FORCE_PATH_STYLE=false.
#   - Cloudflare R2 : S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com.
#     Laisser S3_REGION VIDE : R2 n'a pas de région au sens AWS, et le code signe
#     alors `auto`, le littéral qu'attend Cloudflare. S3_FORCE_PATH_STYLE=true
#     convient (R2 accepte les deux styles) : rien d'autre à changer.
#
# ┌─ AVERTISSEMENT — LIRE AVANT DE BASCULER VERS R2 ─────────────────────────┐
# │                                                                          │
# │ 1. CES DEUX VARIABLES SONT LES IDENTIFIANTS ROOT DE MINIO.               │
# │    docker-compose.prod.yml les interpole en MINIO_ROOT_USER /            │
# │    MINIO_ROOT_PASSWORD (services `minio` et `minio-init`). Y écrire un   │
# │    jeton R2 ne « pointe » donc pas l'API vers R2 : cela RENOMME du même  │
# │    coup le compte root du MinIO qui tourne, dont le volume `minio-data`  │
# │    contient les photos de profil en service. Tant que les deux usages    │
# │    partagent une seule paire de variables, la bascule n'est pas un       │
# │    simple changement d'endpoint.                                         │
# │                                                                          │
# │ 2. CHANGER L'ENDPOINT NE DÉPLACE AUCUN OBJET.                            │
# │    Les photos déjà téléversées restent dans le volume MinIO ; le bucket  │
# │    R2 démarre vide. Sans recopie préalable (`mc mirror` ou `rclone       │
# │    sync`) vers R2, toutes les photos de profil existantes disparaissent  │
# │    de l'interface au redémarrage. Recopier D'ABORD, basculer ENSUITE,    │
# │    et garder le volume MinIO jusqu'à vérification.                       │
# │                                                                          │
# │ Marche à suivre détaillée : docs/24-INFRASTRUCTURE.md.                   │
# └──────────────────────────────────────────────────────────────────────────┘
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET_EXPORTS=lalanda-exports
S3_BUCKET_SNAPSHOTS=lalanda-snapshots
S3_BUCKET_UPLOADS=lalanda-uploads
S3_FORCE_PATH_STYLE=true

# ─── Auth (better-auth — ADR-0006) ──────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET=CHANGE-ME-32-BYTES-MINIMUM-SECRET
AUTH_URL=https://app.lalanda.example

# ─── Coffre des secrets d'intégration (S21b — ADR-0013) ─────
# REQUIS — l'API refuse de démarrer sans, ou si la valeur ne décode pas vers
# exactement 32 octets. Générer : openssl rand -base64 32
#
# Cette clé protège les secrets OpenAI, Stripe, PayPal, SMTP et S3 stockés
# chiffrés en base. Règles d'exploitation NON négociables (ADR-0013 §3, §10) :
#
#   1. la sauvegarder HORS LIGNE et SÉPARÉMENT des sauvegardes MongoDB. Si les
#      deux se retrouvent au même endroit, la séparation coffre/clé disparaît
#      et le chiffrement ne protège plus de rien ;
#   2. la perdre = secrets irrécupérables. La reprise consiste à re-saisir les
#      cinq secrets depuis /admin, la copie faisant autorité étant chez chaque
#      fournisseur ;
#   3. la changer SANS suivre la procédure de rotation rend les secrets
#      illisibles : l'API lève SECRET_KEY_UNAVAILABLE et les intégrations
#      tombent, bruyamment et volontairement.
#
# Rotation : déployer la nouvelle clé en courante et l'ancienne en _PREVIOUS,
# exécuter `pnpm --filter @lalanda/api secrets:rewrap`, vérifier que le rapport
# ne liste aucun keyId restant, puis retirer les deux _PREVIOUS et redéployer.
SECRETS_MASTER_KEY=CHANGE-ME-openssl-rand-base64-32
SECRETS_MASTER_KEY_ID=k1
# SECRETS_MASTER_KEY_PREVIOUS=
# SECRETS_MASTER_KEY_PREVIOUS_ID=k0

# ─── IA (OpenAI — ADR-0008, ADR-0013) ───────────────────────
# OPTIONNELLE depuis S21b : la clé se saisit dans /admin → Intégrations. Cette
# variable reste un secours transitoire ; /admin affiche la source réellement
# utilisée (`db` ou `env`) pour chaque secret.
# OPENAI_API_KEY=sk-CHANGE-ME

# Vérification d'email bloquante à la connexion. À passer à `true` DÈS QUE le
# bloc SMTP ci-dessous est renseigné : c'est ce qui neutralise le pré-enregistrement
# d'un compte non vérifié à l'adresse d'un tiers (ADR-0014 § Risque accepté).
# Domaine du cookie de session (S22m). OBLIGATOIRE ici, parce que le front et
# l'API vivent sur deux hôtes : sans lui, le cookie posé par api.<domaine> n'est
# jamais envoyé à <domaine>, le middleware n'y voit aucune session, et
# l'utilisateur qui vient de se connecter rebondit sur /login sans message.
# Valeur = le domaine PARENT, pas l'hôte de l'API.
AUTH_COOKIE_DOMAIN=lalanda.example

AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─── Connexion Google (ADR-0006 / ADR-0014) — OPTIONNEL ─────
# Les DEUX ou AUCUNE. URI de redirection à déclarer dans Google Cloud Console :
#   https://api.lalanda.example/auth/callback/google
# Procédure complète : docs/adr/ADR-0014.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Envoi d'emails (SMTP — ADR-0014) — OPTIONNEL ───────────
# Sans SMTP_HOST : aucun email n'est envoyé (repli sur log serveur). En
# production, ce bloc conditionne la vérification d'adresse, les invitations et
# la réinitialisation de mot de passe : les laisser vides prive les utilisateurs
# de la récupération de compte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lalanda <no-reply@lalanda.example>

# ─── IA (OpenAI — ADR-0008) ─────────────────────────────────
OPENAI_API_KEY=sk-CHANGE-ME
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_LITE=gpt-4o-mini
